{
  "name": "la-voz-misionera-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.23.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "fixture": "tsx scripts/generate-service-fixture.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:suite": "node scripts/m79-suite-e2e.mjs",
    "test:public-preview": "node scripts/m79-public-e2e.mjs",
    "test:demo": "node scripts/m79-demo-e2e.mjs",
    "test:design-language": "node scripts/verify-design-language.mjs",
    "capture:design-shells": "node scripts/capture-design-shells.mjs",
    "api:dev": "node --env-file-if-exists=.env --import tsx backend/src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx backend/src/migrate-cli.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/db-restore.mjs",
    "test:db-ops": "node --env-file-if-exists=.env scripts/db-operations-smoke.mjs",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:backend:runtime": "npm run build:backend && node scripts/build-backend-runtime.mjs",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "test:db-e2e": "playwright test --config playwright.db.config.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-router": "^1.170.40",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
