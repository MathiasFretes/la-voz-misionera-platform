# Optional local companion link. The file handoff also works without this.
VITE_WORSHIP_URL=http://127.0.0.1:4174/setlist
VITE_WEB_PUBLICA_URL=http://127.0.0.1:4175

DATABASE_URL=postgres://lvm:lvm_dev_only@127.0.0.1:5433/lvm_service
LVM_API_PORT=4318
# Defaults to loopback. Only use 0.0.0.0 inside a private container network.
LVM_API_HOST=127.0.0.1
# Set to postgres to use the API through the same-origin /api proxy.
VITE_SERVICE_BACKEND=local
# VPS: serve the Service interface under /service with the shared suite session.
VITE_SERVICE_BASEPATH=/service
VITE_SERVICE_AUTH=1
# Authenticated multi-church planning; does not upload legacy browser plans automatically.
VITE_SERVICE_PLANNING=church
# Enable only after the connected Worship client and migration 011 pass their joint gate.
# VITE_SERVICE_WORSHIP=connected
# Build-only asset prefix; leave unset for the existing local development flow.
LVM_SERVICE_ASSET_BASE=/service/

# Suite API server only. Unset/0 disables native routes AND native Bearer authentication.
# Enable only for isolated QA or a separately authorized native rollout. Expo cannot enable it.
LVM_NATIVE_AUTH_ENABLED=0
